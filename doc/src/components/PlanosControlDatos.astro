.ecd-planes .t-verb { font-size: 16px; font-weight: 700; fill: var(--sl-color-accent-high); }
.ecd-planes .t-eng { font-size: 23px; font-weight: 700; fill: var(--sl-color-black); }
.ecd-planes .t-eng-sub { font-size: 16px; fill: var(--sl-color-black); }
.ecd-planes .b-ext { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-3); stroke-width: 1.5; }
.ecd-planes .b-ad { fill: var(--sl-color-black); stroke: var(--sl-color-gray-3); stroke-width: 1.2; }
