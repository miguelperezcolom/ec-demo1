.ecd-planes .b-eng { fill: var(--sl-color-accent-high); stroke: none; }
.ecd-planes .b-note { fill: none; stroke: var(--sl-color-gray-4); stroke-width: 1.2; stroke-dasharray: 4 4; }
.ecd-planes .a-ev { fill: none; stroke: var(--sl-color-accent-high); stroke-width: 2; }
.ecd-planes .a-q { fill: none; stroke: var(--sl-color-gray-3); stroke-width: 1.8; stroke-dasharray: 6 5; }
.ecd-planes .m-ev { fill: var(--sl-color-accent-high); }
.ecd-planes .m-q { fill: var(--sl-color-gray-3); }

.ecd-planes .band-cp { fill: var(--sl-color-accent-low); stroke: var(--sl-color-accent); stroke-width: 1.2; }
