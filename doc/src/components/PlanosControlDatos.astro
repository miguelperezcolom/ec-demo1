.ecd-planes .b-cp { fill: var(--sl-color-black); stroke: var(--sl-color-accent); stroke-width: 1.2; }
.ecd-planes .b-eng { fill: var(--sl-color-accent-high); }
.ecd-planes .t-plane { font-size: 24px; font-weight: 800; }
.ecd-planes .t-plane-sub { font-size: 17px; font-weight: 400; fill: var(--sl-color-gray-2); }
.ecd-planes .t-eng { font-size: 20px; }
.ecd-planes .t-eng-mono { font-family: var(--__sl-font-mono); font-size: 16px; fill: var(--sl-color-black); }
.ecd-planes .t-verb { font-size: 20px; }
.ecd-planes .t-flow { font-size: 15px; font-style: italic; fill: var(--sl-color-gray-2); }
.ecd-planes .a-flow { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 2; }
.ecd-planes .a-plane { fill: none; stroke: var(--sl-color-accent); stroke-width: 7; }
.ecd-planes .m-flow { fill: var(--sl-color-gray-2); }
.ecd-planes .m-plane { fill: var(--sl-color-accent); }

</style>
