{
  "realm": "ec-demo1",
  "enabled": true,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "smtpServer": {
    "host": "postfix",
    "port": "25",
    "from": "miguel@mateu.io",
    "fromDisplayName": "EventConductor demo",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Can use the shell and complete human tasks"
      },
      {
        "name": "admin",
        "description": "Can drive workflow definitions and processes"
      },
      {
        "name": "ai-admin",
        "description": "Can configure the AI: agents, models, MCP and RAG sources, and the credentials they hold. Distinct from admin on purpose — the control console reaches the LLM API keys, and driving workflows does not, so neither role implies the other."
      }
    ]
  },
  "clients": [
    {
      "clientId": "demo",
      "name": "EventConductor demo shell",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "https://ec1.mateu.io",
      "baseUrl": "https://ec1.mateu.io",
      "redirectUris": [
        "https://ec1.mateu.io/*",
        "https://rw.ec1.mateu.io/*",
        "https://front.ec1.mateu.io/*",
        "https://ws.ec1.mateu.io/*",
        "https://workspace.ec1.mateu.io/*",
        "https://rw-ws.ec1.mateu.io/*",
        "https://rw-workspace.ec1.mateu.io/*",
        "https://intranet.ec1.mateu.io/*",
        "https://rw-intranet.ec1.mateu.io/*"
      ],
      "webOrigins": [
        "https://ec1.mateu.io",
        "https://rw.ec1.mateu.io",
        "https://front.ec1.mateu.io",
        "https://ws.ec1.mateu.io",
        "https://workspace.ec1.mateu.io",
        "https://rw-ws.ec1.mateu.io",
        "https://rw-workspace.ec1.mateu.io",
        "https://intranet.ec1.mateu.io",
        "https://rw-intranet.ec1.mateu.io"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "control-plane",
      "name": "IA control plane console",
      "description": "Second console, second audience. A token minted for the demo shell is not one for this client, so the gateway can demand the ai-admin realm role on console.ec1.mateu.io without touching ec1.mateu.io.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "https://console.ec1.mateu.io",
      "baseUrl": "https://console.ec1.mateu.io",
      "redirectUris": [
        "https://console.ec1.mateu.io/*",
        "https://rw-console.ec1.mateu.io/*"
      ],
      "webOrigins": [
        "https://console.ec1.mateu.io",
        "https://rw-console.ec1.mateu.io"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "intranet-mcp",
      "name": "Intranet MCP for desktop AI clients",
      "description": "Claude Code, Claude Desktop, Antigravity: the person's own token for the intranet's MCP server (/_intranet/mcp). Login once with the device flow (deploy/demo/intranet-mcp-token.py), then refreshed silently. Its access tokens last 8 hours instead of the realm's 5 minutes, because those clients send a fixed header for a whole session; only this client's tokens, the consoles keep 5 minutes.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "access.token.lifespan": "28800"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@mateu.io",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin",
        "ai-admin"
      ]
    }
  ]
}
