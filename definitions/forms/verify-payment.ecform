# The human decision inside payment-review. One field, because the point of that process is
# the 30-second deadline on the person, not the form.
id: verify-payment
name: Verify payment
description: Confirm whether the customer's payment was received.
fields:
  - id: paymentReceived
    label: Payment received
    dataType: bool
    stereotype: checkbox
    description: Unticked cancels the booking. No answer within 30 seconds cancels it too.

  - id: reference
    label: Payment reference
    dataType: string
    description: Bank or gateway reference, if you have one.
