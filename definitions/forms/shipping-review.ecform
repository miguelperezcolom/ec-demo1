# The human decision inside order-fulfilment.
#
# Every field here becomes a process variable on submit, under its own id, as a string. That
# is why the workflow's guards read `approved == 'true'` and not a boolean: `approved` is the
# id of the checkbox below, and the engine's variables are (name, value) string pairs.
id: shipping-review
name: Review shipping
description: >-
  Stock is reserved and the card is charged. Confirm the order can ship, and on what service.
fields:

  # The guard both outgoing branches of review-shipping are written against.
  - id: approved
    label: Approve shipping
    dataType: bool
    stereotype: checkbox
    description: Leave unticked to cancel the order instead. Cancelling rolls back the charge and the stock reservation.

  - id: carrier
    label: Carrier
    dataType: string
    stereotype: select
    required: true
    options:
      - { value: standard, label: Standard (3-5 days) }
      - { value: express,  label: Express (next day) }
      - { value: pickup,   label: Collect from store }

  - id: shipDate
    label: Requested ship date
    dataType: date

  - id: notes
    label: Notes for the warehouse
    dataType: string
    stereotype: textarea
    description: Optional. Anything the picker needs to know.
