<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Boot 3.4.1 + Spring Cloud 2024.0.0: the pairing the existing api-gw already runs on.
         The shell is on Boot 4 and does not have to match — these are separate processes. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>gateway</artifactId>
    <version>0.1.0</version>
    <name>ec-demo1 gateway</name>
    <description>Routes the console's paths to the shell, orchestrator, forms engine and worker, and requires a Keycloak token for the backends</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <!-- The gRPC grpc-interface's stubs were generated with; runtime and codegen must agree. -->
        <grpc.version>1.77.0</grpc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <!-- Reactive resource server: validates the Keycloak access token on the backend paths. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- /actuator/prometheus does not exist without a registry on the classpath, even with
             actuator present — the scrape would 404 forever and nothing would say so. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- The user's roles and scopes, from the users service's gRPC AuthService, stamped on
             every authenticated request as X-User-Roles / X-User-Scopes — see
             UserAuthorityEnrichmentFilter. The stubs come from control-plane/grpc-interface, which
             deploy/build-images.sh installs before any application module is built.

             Plain grpc-java and not a Spring starter: spring-grpc 1.x (what users runs) needs Boot 4
             and this gateway is on Boot 3.4, and net.devh's starter pins a gRPC far older than the
             1.77 the stubs were generated with. One channel bean is all a client needs. -->
        <dependency>
            <groupId>io.mateu.ecdemo1</groupId>
            <artifactId>grpc-interface</artifactId>
            <version>0.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <!-- Per-token cache of the AuthService answer; the version is Boot's. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <version>${grpc.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
