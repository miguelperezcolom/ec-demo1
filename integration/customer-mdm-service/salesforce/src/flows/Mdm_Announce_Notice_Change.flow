<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>A reception notice (a Case with a Tipo de aviso on a contact) was created or changed — here, or written by the MDM from its Clientes console — and says so, whole: AvisoRecepcionCambiado__e. The MDM projects it without reading it back and tells the hotels (customer-notices). A write of the MDM's own comes back this way too: that is its confirmation. Closing the Case, or unticking Aviso activo, deactivates it.</description>
    <formulas>
        <name>Activo</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Aviso_Activo__c} &amp;&amp; NOT({!$Record.IsClosed})</expression>
    </formulas>
    <formulas>
        <name>MostrarEnTexto</name>
        <dataType>String</dataType>
        <expression>IF(INCLUDES({!$Record.Aviso_Mostrar_En__c}, 'Check-in'), 'Check-in;', '') &amp; IF(INCLUDES({!$Record.Aviso_Mostrar_En__c}, 'Check-out'), 'Check-out;', '') &amp; IF(INCLUDES({!$Record.Aviso_Mostrar_En__c}, 'Estancia'), 'Estancia;', '')</expression>
    </formulas>
    <formulas>
        <name>TipoTexto</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Aviso_Tipo__c})</expression>
    </formulas>
    <label>MDM - Announce reception notice change</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Announce</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK(TEXT({!$Record.Aviso_Tipo__c})))</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <recordCreates>
        <name>Announce</name>
        <label>Announce</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <inputAssignments>
            <field>AvisoId__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MdmAvisoId__c</field>
            <value>
                <elementReference>$Record.MdmAvisoId__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MdmId__c</field>
            <value>
                <elementReference>$Record.Contact.MDM_Id__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId__c</field>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Texto__c</field>
            <value>
                <elementReference>$Record.Subject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tipo__c</field>
            <value>
                <elementReference>TipoTexto</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Desde__c</field>
            <value>
                <elementReference>$Record.Aviso_Desde__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Hasta__c</field>
            <value>
                <elementReference>$Record.Aviso_Hasta__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MostrarEn__c</field>
            <value>
                <elementReference>MostrarEnTexto</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Activo__c</field>
            <value>
                <elementReference>Activo</elementReference>
            </value>
        </inputAssignments>
        <object>AvisoRecepcionCambiado__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
</Flow>
