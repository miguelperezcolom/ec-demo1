<?xml version="1.0" encoding="UTF-8"?>
<!--
  The whole repository in one build: `mvn -DskipTests package` from here builds every module, the
  libraries (integration-model, grpc-interface, ui-commons) first, since the reactor orders them by dependency.

  An aggregator and nothing else: no module has this as its parent, and each still builds on its own
  from its folder (deploy/build-images.sh does it module by module). The modules are grouped by
  system — see README, "What is in here".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.mateu.ecdemo1</groupId>
    <artifactId>ec-demo1</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>ec-demo1</name>

    <modules>
        <!-- systems: the chain's systems -->
        <module>systems/crs/booking</module>
        <module>systems/erp</module>
        <module>systems/front-office</module>
        <module>systems/pms/opera-mock</module>
        <!-- contracts: the language they speak, one library per context, and its schemas -->
        <module>contracts</module>
        <!-- integration: what flows between them -->
        <module>integration/crs-integration-service</module>
        <module>integration/pms-integration-service</module>
        <module>integration/mapping-service</module>
        <module>integration/customer-mdm-service</module>
        <module>integration/journey-service</module>
        <!-- control-plane: who governs it -->
        <module>control-plane/integrations-service</module>
        <module>control-plane/audit-service</module>
        <module>control-plane/communication-service</module>
        <module>control-plane/grpc-interface</module>
        <module>control-plane/users</module>
        <!-- consoles: what people see -->
        <module>consoles/gateway</module>
        <!-- each shell builds its Vaadin image by default and its Redwood one with -Predwood -->
        <module>consoles/shell</module>
        <module>consoles/control-shell</module>
        <!-- ai: the agents -->
        <module>ai/ia-agent</module>
        <module>ai/ia-control-plane</module>
        <module>ai/api-mcp</module>
        <!-- supporting -->
        <module>supporting/content</module>
        <module>supporting/ui-commons</module>
        <module>supporting/messaging</module>
    </modules>
</project>
