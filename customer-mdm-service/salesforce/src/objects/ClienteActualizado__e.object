<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Cliente actualizado</label>
    <pluralLabel>Clientes actualizados</pluralLabel>
    <description>A contact with an MDM id changed its data in Salesforce — by hand, by an approved change request. The MDM reads it and projects it to the hotels.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <eventType>HighVolume</eventType>
    <publishBehavior>PublishAfterCommit</publishBehavior>
    <fields>
        <fullName>MdmId__c</fullName>
        <label>Cliente (MDM)</label>
        <type>Text</type>
        <length>64</length>
        <required>false</required>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
    </fields>
    <fields>
        <fullName>ContactId__c</fullName>
        <label>Contacto</label>
        <type>Text</type>
        <length>18</length>
        <required>false</required>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
    </fields>
</CustomObject>
