<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>A contact's MDM id is the MDM's, not Salesforce's: the merge screen offers to keep the absorbed contact's value on the survivor, and taking it would lose the survivor's own id. Once set, it stays.</description>
    <label>MDM - Keep MDM id</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Had_One</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MDM_Id__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <decisions>
        <name>Had_One</name>
        <label>Had one</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.MDM_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Restore</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <assignments>
        <name>Restore</name>
        <label>Restore</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>$Record.MDM_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record__Prior.MDM_Id__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
