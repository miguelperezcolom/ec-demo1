<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>Someone decided a customer data change request — a Case the MDM opened (Decisión from Pendiente to Aprobada or Rechazada). Approved: the proposed data goes onto the contact — Salesforce is the master of the customer, and this is where a change becomes the customer's data. Either way the decision is announced (CambioClienteResuelto__e) for the MDM.</description>
    <label>MDM - Apply change request</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <formulas>
        <name>EstadoTexto</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Decision__c})</expression>
    </formulas>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Approved</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.MdmRequestId__c})) &amp;&amp; ISCHANGED({!$Record.Decision__c}) &amp;&amp; NOT(ISPICKVAL({!$Record.Decision__c}, 'Pendiente'))</filterFormula>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <decisions>
        <name>Approved</name>
        <label>Approved?</label>
        <locationX>50</locationX>
        <locationY>150</locationY>
        <defaultConnector>
            <targetReference>Announce</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Rejected</defaultConnectorLabel>
        <rules>
            <name>Is_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Aprobada</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ContactId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Apply</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Apply</name>
        <label>Apply to the contact</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <connector>
            <targetReference>Announce</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ContactId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>FirstName</field>
            <value>
                <elementReference>$Record.Nombre__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>$Record.Apellidos__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>$Record.Email__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone</field>
            <value>
                <elementReference>$Record.Telefono__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Birthdate</field>
            <value>
                <elementReference>$Record.FechaNacimiento__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Nationality__c</field>
            <value>
                <elementReference>$Record.Nacionalidad__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Document_Type__c</field>
            <value>
                <elementReference>$Record.TipoDocumento__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Document_Number__c</field>
            <value>
                <elementReference>$Record.NumeroDocumento__c</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
    </recordUpdates>
    <recordCreates>
        <name>Announce</name>
        <label>Announce the decision</label>
        <locationX>50</locationX>
        <locationY>450</locationY>
        <inputAssignments>
            <field>RequestId__c</field>
            <value>
                <elementReference>$Record.MdmRequestId__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MdmId__c</field>
            <value>
                <elementReference>$Record.MdmId__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Estado__c</field>
            <value>
                <elementReference>EstadoTexto</elementReference>
            </value>
        </inputAssignments>
        <object>CambioClienteResuelto__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
</Flow>
